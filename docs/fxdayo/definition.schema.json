{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VMD Viewer evaluated fxdayo definition, schema 2",
  "description": "Structural superset for legacy v1 and extended v2 profiles after Jsonnet evaluation. The selected profile is supplied separately; strict IR validation rejects v2 fields for v1 and checks resource type/format/view combinations, aggregate counts, unique names, references, dimensions, conditions, and scene/reflection contracts. Passing this schema does not authorize execution or imply that all parsed capabilities have live/export input producers.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "fx": {
      "$ref": "#/$defs/fx"
    }
  },
  "required": [
    "fx"
  ],
  "$defs": {
    "controller": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z_0-9]*$"
        },
        "controllerName": {
          "const": "(self)"
        },
        "item": {
          "type": "string"
        },
        "type": {
          "enum": [
            "float",
            "bool",
            "int",
            "float3",
            "float4x4"
          ]
        },
        "desc": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "string",
            "maxLength": 4096
          }
        },
        "slider": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "min": {
              "type": "number"
            },
            "max": {
              "type": "number"
            },
            "def": {
              "type": "number"
            },
            "log": {
              "type": "boolean"
            },
            "int": {
              "type": "boolean"
            }
          }
        }
      },
      "required": [
        "name"
      ]
    },
    "sampler": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z_0-9]*$"
        },
        "filter": {
          "type": "string",
          "pattern": "^(?:[lL][iI][nN][eE][aA][rR]|[mM][iI][nN]_[mM][aA][gG]_[mM][iI][pP]_[lL][iI][nN][eE][aA][rR]|[mM][iI][nN]_[mM][aA][gG]_[lL][iI][nN][eE][aA][rR]_[mM][iI][pP]_[pP][oO][iI][nN][tT]|[pP][oO][iI][nN][tT]|[mM][iI][nN]_[mM][aA][gG]_[mM][iI][pP]_[pP][oO][iI][nN][tT]|[aA][nN][iI][sS][oO][tT][rR][oO][pP][iI][cC])$"
        },
        "addressU": {
          "type": "string",
          "pattern": "^(?:[wW][rR][aA][pP]|[cC][lL][aA][mM][pP]|[mM][iI][rR][rR][oO][rR]|[bB][oO][rR][dD][eE][rR])$"
        },
        "addressV": {
          "type": "string",
          "pattern": "^(?:[wW][rR][aA][pP]|[cC][lL][aA][mM][pP]|[mM][iI][rR][rR][oO][rR]|[bB][oO][rR][dD][eE][rR])$"
        },
        "addressW": {
          "type": "string",
          "pattern": "^(?:[wW][rR][aA][pP]|[cC][lL][aA][mM][pP]|[mM][iI][rR][rR][oO][rR]|[bB][oO][rR][dD][eE][rR])$"
        },
        "borderColor": {
          "type": "string",
          "pattern": "^(?:[tT][rR][aA][nN][sS][pP][aA][rR][eE][nN][tT]_[bB][lL][aA][cC][kK]|[oO][pP][aA][qQ][uU][eE]_[bB][lL][aA][cC][kK]|[oO][pP][aA][qQ][uU][eE]_[wW][hH][iI][tT][eE])$"
        },
        "maxAnisotropy": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        }
      },
      "required": [
        "name"
      ]
    },
    "size": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "absolute": {
          "type": "boolean"
