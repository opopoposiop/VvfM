        },
        "view": {
          "type": "string",
          "pattern": "^(?:(?:[sS][rR][vV]|[rR][tT][vV]|[uU][aA][vV])(?:[ \\t]*,[ \\t]*(?:[sS][rR][vV]|[rR][tT][vV]|[uU][aA][vV]))*)?$"
